# ==============================================================================
# FinGuard AI Environment Variables Configuration
# ==============================================================================

PROJECT_NAME="FinGuard AI"
VERSION="1.0.0"
API_PREFIX="/api/v1"

# Database Configuration:
# Default: Local SQLite for zero-friction setup
DATABASE_URL="sqlite:///./finguard.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://finguard_user:StrongPassword@localhost:5432/finguard_db"

# JWT Authentication Security:
# Generated random key for production. NEVER commit secrets to version control.
SECRET_KEY="finguard-ai-super-secret-educational-key-change-in-prod-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client CORS Origins (Comma-separated in production)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
